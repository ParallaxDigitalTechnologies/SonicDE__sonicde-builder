#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
# Fetch one configured repository, without fetching its dependencies.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

if [ "$#" -eq 0 ]; then
    printf 'Usage: %s REPOSITORY [--dry-run]\n' "$0" >&2
    exit 2
fi
case "$1" in
    -h|--help)
        printf 'Usage: %s REPOSITORY [--dry-run]\n' "$0"
        printf 'Example: %s sonic-browser-integration\n' "$0"
        exit 0
        ;;
    ""|-*) printf 'The first argument must be a repository name.\n' >&2; exit 2 ;;
esac

exec python3 "$SCRIPT_DIR/scripts/fetch.py" "$@"
